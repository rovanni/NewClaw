{
  "name": "newclaw",
  "version": "2.4.0",
  "description": "Agente pessoal de IA 100% local com Telegram",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "node scripts/check-runtime.cjs",
    "dev": "ts-node src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); const path=require('path'); const src=path.join('src','dashboard','public'); const dest=path.join('dist','dashboard','public'); fs.mkdirSync(path.dirname(dest), {recursive:true}); fs.cpSync(src, dest, {recursive:true, force:true}); console.log('Dashboard static files copied to dist/')\"",
    "start": "node dist/index.js",
    "start:debug": "node --inspect dist/index.js",
    "recover": "node scripts/recover-db.cjs",
    "test:regression": "node scripts/run-regression-tests.cjs",
    "test:regression:selftest": "node scripts/run-regression-tests.cjs --selftest",
    "test:regression:afetados": "node scripts/run-regression-tests.cjs --afetados",
    "test:integration": "ts-node scripts/testes/integration-campaign-runner.ts"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc13": true,
    "protobufjs@7.6.5": true,
    "better-sqlite3": true
  },
  "peerDependencies": {
    "newclaw-kernel-adapter": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "newclaw-kernel-adapter": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.2.1",
    "@types/node": "^20.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "grammy": "^1.42.0",
    "jszip": "^3.10.2",
    "multer": "^2.3.0",
    "node-edge-tts": "^1.2.10",
    "p-queue": "^9.2.0",
    "pptxgenjs": "^4.0.1",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "undici": "6.28.1"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0"
  },
  "overrides": {
    "undici": "6.28.1",
    "sharp": "^0.35.5",
    "qs": "^6.16.0",
    "image-size": "^2.0.4",
    "music-metadata": "^11.16.0"
  }
}
