# NewClaw — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# ─── Identidade do Dono (ESSENCIAL para agente single-owner) ──
# Nome do proprietário permanente deste sistema.
# Após configurado, o LLM não consegue alterar esta identidade.
OWNER_NAME=
# ID do usuário principal (ex: ID do Telegram do dono)
OWNER_USER_ID=
# Se true, bloqueia qualquer alteração automática da identidade do dono.
# Recomendado: true após concluir o onboarding.
OWNER_LOCKED=false

# ─── Telegram (canal principal) ───────────────────────────────
# Token do bot: Telegram → @BotFather → /newbot → copie o token
TELEGRAM_BOT_TOKEN=
# Seu ID de usuário: Telegram → @userinfobot → copie o ID
TELEGRAM_ALLOWED_USER_IDS=

# ─── Discord (opcional) ──────────────────────────────────────
# Token do bot: Discord → Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=
# IDs dos servidores permitidos (vazio = todos)
DISCORD_ALLOWED_GUILD_IDS=
# IDs de usuários permitidos (vazio = todos nos guilds permitidos)
DISCORD_ALLOWED_USER_IDS=

# ─── WhatsApp (opcional) ─────────────────────────────────────
# Número de telefone com código do país (ex: +5511999999999)
WHATSAPP_PHONE_NUMBER=
# JIDs permitidos (vazio = todos os contatos)
WHATSAPP_ALLOWED_JIDS=
# Diretório de autenticação (sessão WhatsApp)
WHATSAPP_AUTH_DIR=./data/whatsapp-auth

# ─── Signal (opcional) ───────────────────────────────────────
# Número de telefone com código do país (ex: +5511999999999)
SIGNAL_PHONE_NUMBER=
# Números permitidos (vazio = todos)
SIGNAL_ALLOWED_NUMBERS=
# Caminho do signal-cli (padrão: signal-cli)
SIGNAL_CLI_PATH=signal-cli
# Diretório --config do signal-cli, onde ele grava os anexos recebidos (attachments/<id>).
# Sem isto, anexos recebidos por Signal continuam sem ser lidos (o caminho padrão do signal-cli
# varia por sistema operacional e não é adivinhado). Ex.: o mesmo diretório que você passaria em
# `signal-cli --config <dir> ...` ao registrar o número.
SIGNAL_CLI_CONFIG_DIR=

# ─── Anexos (opcional) ────────────────────────────────────────
# Teto de tamanho (bytes) para um anexo materializado em memória a partir de qualquer canal.
# Padrão: 20MB (mesmo limite já usado pelo upload do Dashboard web).
MAX_ATTACHMENT_BYTES=20971520

# ─── Idioma ───────────────────────────────────────────────────
# Opções: pt-BR | en-US | es-ES
APP_LANG=pt-BR

# ─── Provider padrão ─────────────────────────────────────────
# Opções: ollama | openrouter | gemini | deepseek | groq | anthropic
DEFAULT_PROVIDER=ollama

# ─── API Keys (opcional — apenas se usar providers em nuvem) ──
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Anthropic nativo (api.anthropic.com) — sem markup do OpenRouter, com suporte a
# prompt caching e extended thinking nativos.
ANTHROPIC_API_KEY=
# Modelo de cada provedor — escolha sua (painel: Config → Modelos, ou aqui). O NewClaw não tem modelo no código
# nem reserva: vazio, o provedor não responde e o NewClaw avisa para escolher. Use o ID exato do provedor.
GEMINI_MODEL=
DEEPSEEK_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
ANTHROPIC_MODEL=

# ─── Ollama (local / nuvem) ───────────────────────────────────
OLLAMA_URL=http://localhost:11434
# Modelo padrão — escolha sua (painel: Config → Modelos, ou aqui). O NewClaw não escolhe modelo por conta
# própria (issue 068): vazio, ele não responde e avisa para escolher. Ex.: glm-5.2:cloud, gemma4:31b-cloud, llama3.2
OLLAMA_MODEL=
# Deixe vazio se não usa autenticação no Ollama
OLLAMA_API_KEY=
# Modelo de embedding (busca semântica na memória), servido pelo Ollama. Vazio = desligado: a busca segue por
# palavras. Ex.: nomic-embed-text:v1.5 (precisa estar baixado no Ollama: ollama pull nomic-embed-text:v1.5)
EMBED_MODEL=

# ─── Modelos dos templates de conversa ───────────────────────
# Nome do modelo compatível com DEFAULT_PROVIDER (ou com PROVIDER_* do perfil).
# Ollama:      MODEL_CHAT=glm-5.2:cloud
# OpenRouter:  MODEL_CHAT=anthropic/claude-3.5-sonnet
# Gemini:      MODEL_CHAT=gemini-2.0-flash
# ChatGPT:     MODEL_CHAT=gpt-4o
# O código não escolhe modelo nenhum (issue 068). Vazio: MODEL_CHAT usa o modelo padrão do provedor
# (OLLAMA_MODEL / "Modelo padrão" do painel); os demais perfis de texto herdam o MODEL_CHAT; MODEL_VISION
# vazio = visão não configurada (imagens não são descritas por um modelo que talvez não as leia).
MODEL_CHAT=
MODEL_CODE=
MODEL_VISION=
MODEL_LIGHT=
MODEL_ANALYSIS=
MODEL_EXECUTION=

# ─── Provider por perfil (opcional) ──────────────────────────
# Permite usar providers diferentes por categoria de conversa.
# Se não definido, usa DEFAULT_PROVIDER para todos os perfis.
# Exemplo: usar Gemini para chat e OpenRouter para código:
#   PROVIDER_CHAT=gemini
#   PROVIDER_CODE=openrouter
PROVIDER_CHAT=
PROVIDER_CODE=
PROVIDER_VISION=
PROVIDER_LIGHT=
PROVIDER_ANALYSIS=
PROVIDER_EXECUTION=

# ─── Modelos dos componentes internos ────────────────────────
# Nome compatível com DEFAULT_PROVIDER.
# Ollama:      PLANNER_MODEL=gemma4:31b-cloud
# OpenRouter:  PLANNER_MODEL=google/gemini-2.0-flash
# Gemini:      PLANNER_MODEL=gemini-2.0-flash
# ChatGPT:     PLANNER_MODEL=gpt-4o-mini
PLANNER_MODEL=
# RISK_MODEL: modelo do REVISOR de plano (escreve o plano corrigido quando a validação aponta risco).
RISK_MODEL=
# OBSERVER_MODEL: modelo do JUIZ — UM só para todas as validações (resposta contra evidência, qualidade da resposta,
# resultado do passo, conclusão do objetivo, risco do plano, conteúdo-molde e suficiência do pedido). Mudar aqui (ou no
# painel) muda o juiz de todos. Vazio = o modelo padrão do provedor.
OBSERVER_MODEL=

# ─── Modelos customizados (gerenciado pelo dashboard) ─────────
# Lista separada por vírgulas. Não editar manualmente.
CUSTOM_MODELS=

# ─── Provedores OpenAI-Compatible (gerenciado pelo dashboard) ─
# JSON com endpoints próprios: LM Studio, vLLM, llamafile, OpenAI oficial ou qualquer servidor
# que exponha /v1/models e /v1/chat/completions. Use "Testar conexão" no dashboard (Modelos →
# Provedores) em vez de editar à mão. Exemplo de formato:
#   CUSTOM_PROVIDERS=[{"label":"llamafile","baseUrl":"http://localhost:8080/v1"}]
# Depois de cadastrado, o label pode ser usado em DEFAULT_PROVIDER e nos PROVIDER_* por perfil.
CUSTOM_PROVIDERS=

# ─── Pasta dos seus modelos locais (.gguf) ───────────────────
# Onde VOCÊ guarda seus arquivos de modelo. Sem valor padrão de propósito: cada sistema (Windows,
# Linux, macOS) e cada usuário usa um lugar diferente. Só é lida para listar os modelos no
# dashboard (Modelos → Instalar Modelo → "Meus arquivos"); o NewClaw não move nem abre os arquivos.
# Exemplos: LOCAL_MODELS_DIR=C:\meus-modelos   |   LOCAL_MODELS_DIR=/home/voce/modelos
LOCAL_MODELS_DIR=

# Porta em que o NewClaw sobe o servidor do modelo local (llamafile/llama-server) ao clicar em
# "Usar este modelo". Só precisa mudar se a 8080 já estiver ocupada, ou se você rodar duas
# instâncias do NewClaw na mesma máquina — cada uma precisa da sua.
LOCAL_SERVER_PORT=8080

# Opções extras passadas ao servidor ao carregar CADA modelo local, em JSON:
#   {"modelo.gguf": "-fit off --n-gpu-layers 12 -c 8192"}
# Gerenciado pelo dashboard (Modelos > Adicionar Modelo > Meus arquivos > ⚙️). Nunca vem
# preenchido: os valores certos dependem da GPU e da memória de CADA máquina — a divisão de
# camadas ideal numa placa de 16GB é errada numa de 8GB. Consulte a documentação do servidor
# local que você usa (llamafile, llama-server) para saber quais parâmetros ele aceita.
LOCAL_MODEL_OPTIONS=

# ─── Diagnóstico de contaminação de memória (opcional) ────────
# Termos pessoais/sensíveis (separados por vírgula) que o ContextBuilder e o SessionContext
# checam nos logs [USER-EXPANDED]/[FINAL-CONTEXT] pra auditar se vazaram pra um contexto não
# relacionado. Feature só de diagnóstico — não bloqueia nem filtra nada sozinha. Deixe vazio
# se não quiser essa auditoria; cada instalação define os seus próprios termos aqui (arquivo
# local, nunca versionado) em vez de hardcoded no código-fonte.
# Exemplo: CONTAMINATION_WATCH_TERMS=minha-cidade,meu-time,minha-empresa
CONTAMINATION_WATCH_TERMS=

# ─── Logging ─────────────────────────────────────────────────
# Caminho do arquivo de log de auditoria (sem ANSI). Padrão: definido no ecosystem.config.cjs
# Defina aqui para sobrescrever ao rodar fora do PM2 (ex: npm start direto).
LOG_FILE=./logs/newclaw-audit.log
# Nível de log: debug | info | warn | error (padrão: info)
LOG_LEVEL=info

# ─── Política de uncaughtException/unhandledRejection (opcional) ─────────────
# continue (padrão): processo permanece vivo mesmo após TypeError/RangeError/ReferenceError
#   inesperados — recomendado em ambientes SEM supervisor de restart imediato (ex.: Windows
#   via Tarefa Agendada).
# restart: encerra o processo (exit 1) nesses casos e deixa o supervisor (systemd, PM2)
#   reiniciar em estado limpo — recomendado em ambientes COM supervisor residente (Linux/VPS).
# Corrupção de SQLite, OOM e invariantes explicitamente violadas SEMPRE reiniciam, independente
# desta variável. Ver src/core/UncaughtExceptionPolicy.ts.
UNCAUGHT_EXCEPTION_POLICY=continue

# ─── Config ───────────────────────────────────────────────────
MAX_ITERATIONS=8
MEMORY_WINDOW_SIZE=20
SKILLS_DIR=./skills
# Aprendizado de skills (docs/decisoes/ADR-017): ao concluir uma tarefa validada, o NewClaw escreve a skill com o procedimento
# que funcionou, ativa e avisa na conversa (desfazer: /skill_desativar <nome>).
#   automatico = padrão | proposta = comportamento anterior (moldes que esperam aprovação) | desligado = não aprende
APRENDIZADO_DE_SKILLS=automatico
WORKSPACE_DIR=./workspace
TMP_DIR=./workspace/tmp

# ─── Dashboard Web ────────────────────────────────────────────
DASHBOARD_PORT=3090
# Interface de rede (default 127.0.0.1 = somente localhost).
# Para expor em LAN/proxy reverso use 0.0.0.0 — e OBRIGATORIAMENTE defina DASHBOARD_PASSWORD.
DASHBOARD_HOST=127.0.0.1
# Senha do dashboard. Sem ela, /api/* fica aberto. Recomendado defini-la sempre.
DASHBOARD_PASSWORD=

# ─── Cofre de segredos (ADR-019) ─────────────────────────────
# Senhas que você envia no chat (ou com /segredo <nome> <valor>) são guardadas aqui como SEGREDO_<NOME> e
# circulam só como o marcador <SEGREDO:nome> — nunca em logs, histórico ou prompts. Gerencie pelo chat:
# /segredos (lista os nomes) e /segredo_apagar <nome>. Não precisa preencher nada aqui.

# ─── Trabalho longo: só para por travamento (ADR-027) ─────────────────────────
# O NewClaw não para um trabalho por tempo: só quando ele trava (o modelo fica em silêncio, um comando fica sem nenhum
# sinal de atividade, ou o objetivo repete ciclos sem avançar), quando você usa "Parar" / /cancelar, ou ao concluir.
# Segundos de silêncio do modelo (nenhum pedaço de resposta chegando) até a chamada ser tida como travada. Padrão 90.
# SILENCIO_DO_MODELO_S=90
# A cada N minutos, um objetivo em andamento manda um relato no mesmo canal: há quanto tempo roda, o que concluiu desde o
# último relato e o passo atual (sem chamada de modelo). Padrão 5; 0 desliga.
# RELATO_DE_PROGRESSO_MIN=5
# Quanto tempo um objetivo PARADO à sua espera (autorização, esclarecimento) fica aberto. Não limita trabalho. Padrão 30.
# LIMITE_DO_OBJETIVO_MIN=30

# ─── Instrumentação da revisão de plano (opcional, campanha S-D) ───────────────
# Modo sombra do RiskAnalyzer (src/loop/RiskAnalyzer.ts): a revisão por LLM roda em segundo plano,
# NÃO é aplicada ao plano, e cada revisão vira uma linha [RISK-SHADOW] no log (plano antes/depois,
# diff, reparos do sanitizer, duração). O plano real é sempre o do Planner. Default false: nada
# muda. Ligado, o custo é uma chamada de LLM por plano complexo (a mesma de hoje), só que fora do
# caminho crítico. Não ligar em uso normal — serve para coletar evidência.
RISK_REVIEW_SHADOW=false
# Resposta vazia porque o modelo gastou o limite de saída raciocinando (done_reason "length"): hoje a mesma
# chamada é repetida e refeita sem streaming, e o log registra em [CORTE-LIMITE-SOMBRA] o que isso rendeu (S452).
# Com 1, o corte não é repetido nem refeito — poupa minutos quando o juiz corta. Ligar depois que a sombra mostrar
# que a repetição não rende.
# CORTE_PELO_LIMITE_SEM_REPETIR=1
# Acrescenta CONTEÚDO aos traces ([GROUNDING-TRACE]: texto da resposta e evidência exata; [GOAL-INTENT]: o
# pedido integral; gravador de voo dos avaliadores: prompt, evidência inteira, raciocínio do modelo e saída
# bruta). Contém dados do usuário — não ligar em uso normal.
TRACE_CONTENT=false
# Gravador de voo dos avaliadores (ADR-013): juiz de grounding, validador de qualidade e análise de risco gravam
# cada julgamento (antes/durante/depois) em <pasta do LOG_FILE>/avaliadores/<avaliador>-AAAA-MM-DD.jsonl. Liga
# junto com LOG_FILE; sem TRACE_CONTENT=true grava só fatos (tempos, tamanhos, estados). Dias de retenção:
EVALUATOR_LOG_RETENTION_DAYS=14
# ADR-015 — suficiência do pedido: antes de usar ferramentas, o NewClaw confere se o pedido (ou a memória) traz os
# dados do usuário que a ação exige; se faltar e ninguém tiver, PERGUNTA em vez de adivinhar. Custa uma chamada ao
# modelo por pedido de ferramenta. off = desliga (volta ao comportamento anterior).
VALIDACAO_SUFICIENCIA=on
# ADR-014 — validador único: TODAS as validações por LLM (resposta contra evidência, qualidade, passo, conclusão, risco,
# conteúdo-molde, suficiência) decidem pelo mesmo motor, com o mesmo modelo (OBSERVER_MODEL). O gravador de voo grava
# cada julgamento em <pasta do LOG_FILE>/avaliadores/validacao_<tipo>-AAAA-MM-DD.jsonl.
# Portão "ação afirmada sem execução": quando o pedido exige ferramenta e nenhuma rodou com sucesso, a resposta que
# afirma ter feito algo ("Salvo!") é julgada e, se for falsa, não é entregue. Custa uma chamada ao modelo nesses
# turnos. off = desliga.
VALIDACAO_ACAO_AFIRMADA=on

# ─── Cognitive Kernel (opcional) ──────────────────────────────
# Kill-switch do cutover para o Cognitive Kernel (newclaw-kernel-adapter) — ver
# src/loop/CognitiveKernelGate.ts. Default false: nenhuma chamada ao Kernel acontece,
# comportamento idêntico ao de hoje.
COGNITIVE_KERNEL_ENABLED=false
# Incidente real (2026-07-31): com COGNITIVE_KERNEL_ENABLED=true e esta flag em true, um goal
# recém-criado sem histórico entrava em loop (DEFER/REQUEST_MORE_INFO nunca resolviam, pois o
# goal abandonado é reclassificado do zero e bate na mesma decisão de novo). Default false:
# o Kernel roda e loga a decisão (modo sombra em processo), mas nunca muda o comportamento —
# só EXECUTE (já um no-op) é "real". Não ligar sem recalibrar DEFER/REQUEST_MORE_INFO/ESCALATE
# para o caso de goal sem histórico.
COGNITIVE_KERNEL_APPLY_DECISION=false

# ─── Busca na web (opcional) ─────────────────────────────────
# URL da SUA instância SearXNG, se você tiver uma. Aceita a origem
# (http://meu-host:8888) ou o endpoint completo (http://meu-host:8888/search).
# Vazio = esta fonte não é consultada. Não existe endereço padrão: nenhuma
# instalação envia suas buscas para um servidor que você não escreveu aqui.
#
# Até 06/08/2026 o código tentava localhost:8888 e, se falhasse, mandava a mesma
# consulta para searx.be — um servidor público de terceiros. Se você usava isso
# sem saber, e quer a fonte de volta, aponte esta variável para a sua instância.
SEARXNG_URL=

# ─── Whisper / TTS (opcional) ────────────────────────────────
# URL de uma API Whisper remota, se você tiver uma. Vazio = transcrição local
# (whisper-cli), sem nenhuma requisição de rede. Não existe endereço padrão:
# nenhuma instalação envia áudio para um host que você não escreveu aqui.
# Exemplo: http://localhost:8177
WHISPER_API_URL=
# URL alternativa, tentada quando a primeira falha. Mesmas regras acima.
WHISPER_API_FALLBACK=
# Caminho local do whisper (se instalado localmente)
WHISPER_PATH=

# Servidor TTS próprio, compatível com a API OpenAI (POST /v1/audio/speech — ex.:
# Kokoro-FastAPI). Vazio = nenhum: o áudio sai pelo Piper (se declarado) ou pelo edge-tts
# (serviço da Microsoft, online). Não existe endereço padrão. Quando declarado, é a primeira
# engine tentada; se falhar, o usuário é avisado de que o texto saiu da máquina.
# Exemplo: http://localhost:8880
KOKORO_TTS_URL=
# Id da voz no servidor acima. Vazio = o servidor escolhe a voz padrão dele. Os catálogos
# são por idioma (ex.: Kokoro usa pm_*/pf_* para português, am_*/af_* para inglês).
KOKORO_TTS_VOICE=
# Modelo whisper (tiny, base, small, medium, large)
WHISPER_MODEL=tiny
